{
  "name": "nexa",
  "version": "0.1.0",
  "private": true,
  "description": "NEXA - WhatsApp-first personal AI agent",
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "pnpm -r run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --ext .ts",
    "typecheck": "tsc --build --noEmit",
    "dev": "pnpm --filter @nexa/api dev",
    "start": "pnpm --filter @nexa/api start"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
