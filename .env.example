# ==========================================
# NEXA - Environment Configuration
# ==========================================

# Node & Server
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Google Gemini AI
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Meta WhatsApp Cloud API
WHATSAPP_ACCESS_TOKEN=your_whatsapp_system_user_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here
WHATSAPP_BUSINESS_ACCOUNT_ID=your_whatsapp_business_account_id_here
WHATSAPP_VERIFY_TOKEN=your_custom_webhook_verification_token_here
WHATSAPP_APP_SECRET=your_meta_app_secret_here

# Supabase PostgreSQL Database
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Optional: Web Search Provider (defaults to DuckDuckGo HTML/API if empty)
# TAVILY_API_KEY=
# SERPER_API_KEY=

# Security & Limits
MAX_AGENT_STEPS=10
RATE_LIMIT_MAX_REQUESTS_PER_MINUTE=30
APPROVAL_TIMEOUT_MINUTES=60
